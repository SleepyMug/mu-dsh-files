{
  "name": "mu-dsh-files",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "mu-dsh's dsh plugin: a Files tab that follows the disk and takes over dsh's own, folder links that open in it, and downloads of files and folders from the web UI",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node --test test/"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-files": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "picomatch": "4.0.7",
    "typescript": "^5.9.0"
  }
}
