{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/client", "src/wire.ts"]
}
